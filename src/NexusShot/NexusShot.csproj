<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- Windows 10 is the real floor: the app uses Direct2D effects (Windows 8+) and per-monitor v2
         DPI awareness (Windows 10+), which the manifest already declares. A bare `net10.0-windows`
         implies Windows 7, and the platform analyzer then flags every effect call as unsupported. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <RootNamespace>NexusShot</RootNamespace>
    <AssemblyName>NexusShot</AssemblyName>

    <!-- The fallback for a local build. A release overrides it with the tag, via build.ps1's
         -p:Version. The settings header reads it back off the assembly. -->
    <Version>0.3.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\nexus-shot.ico</ApplicationIcon>

    <!-- The whole point of the rewrite: a single native exe with no runtime payload.
         DirectNAot is built for this - source-generated LibraryImport and ComWrappers,
         no classic COM interop, so nothing here needs a reflection fallback. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep actionable diagnostics for failures in native capture/rendering paths. -->
    <StackTraceSupport>true</StackTraceSupport>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- AOT marshalling for collections handed to WinRT at call sites, e.g. the share sheet's file list. -->
    <CsWinRTAotOptimizerEnabled>Auto</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DirectNAot" Version="1.6.6" />
    <!-- Ships Window / D2DRenderWindow / Application: the Win32 host and message loop,
         maintained by the interop author. We inherit rather than hand-roll a WndProc. -->
    <PackageReference Include="DirectNAot.Extensions" Version="1.6.6" />
  </ItemGroup>

  <!-- DirectN's own projects declare these globally; its API is written assuming they are in
       scope (COM wrappers, D2D structs, the Win32 host types). -->
  <ItemGroup>
    <Using Include="DirectN" />
    <Using Include="DirectN.Extensions" />
    <Using Include="DirectN.Extensions.Com" />
    <Using Include="DirectN.Extensions.Utilities" />
    <!-- DirectN.Extensions.Utilities has an Icon of its own; the app means the stroke icon. -->
    <Using Include="NexusShot.Render.Icon" Alias="Icon" />
  </ItemGroup>

</Project>
